# Copy this file to .env and set SECRET_KEY to a generated random value.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///securecore.db
# Use development for local HTTP; production requires HTTPS.
APP_ENV=development
# Development defaults to memory://; set a persistent shared backend for production.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# Keep false for local HTTP. Production requires true and rejects HTTP requests.
SESSION_COOKIE_SECURE=false
FLASK_DEBUG=false
# Set only behind a trusted reverse proxy that overwrites X-Forwarded-Proto.
# The app trusts this count only for protocol detection, not client IP addresses.
TRUSTED_PROXY_COUNT=0
# For production, set APP_ENV=production and SESSION_COOKIE_SECURE=true.
# Set TRUSTED_PROXY_COUNT to the exact trusted proxy count when TLS terminates upstream.
# Enable only for local mock simulations; keep false in deployment.
BRUTE_FORCE_SIMULATOR_ENABLED=false
# Comma-separated trusted users.id values; leave empty to disable monitoring access.
SECURITY_DASHBOARD_ADMIN_IDS=
# Local development only: provisions the Argon2id-hashed demo admin when no admin exists.
# Defaults to admin/admin in development and is rejected in production.
DEMO_ADMIN_ENABLED=true
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_EMAIL=admin@securecore.local
DEMO_ADMIN_PASSWORD=admin
